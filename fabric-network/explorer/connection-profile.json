{
  "name": "governance-network",
  "version": "1.0.0",
  "client": {
    "organization": "Org1",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        }
      }
    }
  },
  "organizations": {
    "Org1": {
      "mspid": "Org1MSP",
      "peers": ["peer0.org1.example.com"],
      "certificateAuthorities": ["ca.org1.example.com"]
    }
  },
  "orderers": {
    "orderer.example.com": {
      "url": "grpc://fabric-orderer:7050"
    }
  },
  "peers": {
    "peer0.org1.example.com": {
      "url": "grpc://fabric-peer:7051",
      "eventUrl": "grpc://fabric-peer:7053"
    }
  },
  "certificateAuthorities": {
    "ca.org1.example.com": {
      "url": "https://fabric-ca:7054",
      "caName": "ca.org1.example.com",
      "tlsCACerts": {
        "pem": ["-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"]
      },
      "httpOptions": {
        "verify": false
      }
    }
  }
}




